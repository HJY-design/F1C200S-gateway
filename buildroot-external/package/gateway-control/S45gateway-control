#!/bin/sh
pidfile=/run/gateway-control.pid
case "$1" in
  start)
    printf 'Starting gateway GPIO control: '
    start-stop-daemon -S -q -b -m -p "$pidfile" -x /usr/sbin/gateway-ctl -- daemon
    ;;
  stop)
    start-stop-daemon -K -q -p "$pidfile" -x /usr/sbin/gateway-ctl
    rm -f "$pidfile"
    ;;
  restart)
    "$0" stop
    sleep 1
    "$0" start
    ;;
  *) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
