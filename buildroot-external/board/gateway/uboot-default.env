bootcmd=mtd list; if mtd read kernel ${kernel_addr_r} 0 0x500000; then bootm ${kernel_addr_r}; fi
bootargs=console=ttyS0,115200n8 ubi.mtd=rootfs root=ubi0:rootfs rootfstype=ubifs rw
kernel_addr_r=0x81000000
fdt_addr_r=0x80f00000
bootm_low=0x80000000
bootm_size=0x04000000
stdin=serial
stdout=serial
stderr=serial
