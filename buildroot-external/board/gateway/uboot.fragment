CONFIG_DEFAULT_DEVICE_TREE="uboot-gateway"
CONFIG_SPL_SPI_SUNXI_GATEWAY_NAND=y
CONFIG_DM_MTD=y
CONFIG_MTD_SPI_NAND=y
CONFIG_CMD_MTD=y
# CONFIG_ENV_IS_IN_FAT is not set
# CONFIG_ENV_IS_IN_SPI_FLASH is not set
CONFIG_ENV_IS_NOWHERE=y
# CONFIG_SPI_FLASH is not set
# CONFIG_CMD_SF is not set
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="mtd list; if mtd read kernel ${kernel_addr_r} 0 0x500000; then bootm ${kernel_addr_r}; fi"
CONFIG_BOOTDELAY=2
CONFIG_AUTOBOOT_KEYED=y
CONFIG_AUTOBOOT_PROMPT="Autoboot in %d seconds; type GWMAINT for maintenance\n"
CONFIG_AUTOBOOT_DELAY_STR="GWRETRY"
CONFIG_AUTOBOOT_STOP_STR="GWMAINT"
# CONFIG_AUTOBOOT_KEYED_CTRLC is not set
CONFIG_BOOT_RETRY=y
CONFIG_BOOT_RETRY_TIME=60
CONFIG_BOOT_RETRY_MIN=60
CONFIG_RESET_TO_RETRY=y
CONFIG_SPL_LEGACY_IMAGE_CRC_CHECK=y
