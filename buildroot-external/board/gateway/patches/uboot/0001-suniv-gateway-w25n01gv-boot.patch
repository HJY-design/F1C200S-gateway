From: Gateway board adaptation <local-build@localhost>
Subject: [PATCH] suniv: custom W25N01GV gateway SPL reader

For this board only: fixed 1KiB ROM payload/page, bounded read waits, W25N01GV
JEDEC ID, internal ECC status, and bad-block skipping within the 4MiB boot area.
Keep the unselected upstream NOR path. Enable using the board config fragment.
The 1KiB SUNIV page convention follows Icenowy Zheng's published 2022 proposal:
https://www.mail-archive.com/linux-sunxi@googlegroups.com/msg35536.html
Command constants come from the Winbond W25N01GV Rev G data sheet.
This is a local board adaptation, not an upstream patch or a hardware test result.

diff --git a/arch/arm/mach-sunxi/Kconfig b/arch/arm/mach-sunxi/Kconfig
--- a/arch/arm/mach-sunxi/Kconfig
+++ b/arch/arm/mach-sunxi/Kconfig
@@ -1102,6 +1102,14 @@
 	  sunxi SPI Flash. It uses the same method as the boot ROM, so does
 	  not need any extra configuration.
 
+config SPL_SPI_SUNXI_GATEWAY_NAND
+	bool "Custom SUNIV gateway W25N01GV boot"
+	depends on SPL_SPI_SUNXI && MACH_SUNIV
+	help
+	  Board-specific W25N01GV reader with ECC and factory-bad-block checks.
+	  SPL and U-Boot must both use 1024-byte payloads in 2048-byte pages.
+	  The first 4 MiB are reserved for boot; block 0 must be good.
+
 config PINE64_DT_SELECTION
 	bool "Enable Pine64 device tree selection code"
 	depends on MACH_SUN50I
diff --git a/arch/arm/mach-sunxi/board.c b/arch/arm/mach-sunxi/board.c
--- a/arch/arm/mach-sunxi/board.c
+++ b/arch/arm/mach-sunxi/board.c
@@ -226,8 +226,9 @@
 		return SUNXI_BOOTED_FROM_SPI;
 	case SUNIV_BOOTED_FROM_MMC1:
 		return SUNXI_BOOTED_FROM_MMC2;
-	/* SPI NAND is not supported yet. */
 	case SUNIV_BOOTED_FROM_NAND:
+		if (IS_ENABLED(CONFIG_SPL_SPI_SUNXI_GATEWAY_NAND))
+			return SUNXI_BOOTED_FROM_SPI;
 		return SUNXI_INVALID_BOOT_SOURCE;
 	}
 	/* If we get here something went wrong try to boot from FEL.*/
diff --git a/arch/arm/mach-sunxi/spl_spi_sunxi.c b/arch/arm/mach-sunxi/spl_spi_sunxi.c
--- a/arch/arm/mach-sunxi/spl_spi_sunxi.c
+++ b/arch/arm/mach-sunxi/spl_spi_sunxi.c
@@ -322,7 +322,7 @@
 	udelay(1);
 }
 
-static void spi0_read_data(void *buf, u32 addr, u32 len)
+static void __maybe_unused spi0_read_data(void *buf, u32 addr, u32 len)
 {
 	u8 *buf8 = buf;
 	u32 chunk_len;
@@ -361,11 +361,51 @@
 	}
 }
 
+#ifdef CONFIG_SPL_SPI_SUNXI_GATEWAY_NAND
+static int gateway_spi_xfer(const u8 *tx, u32 txlen, u8 *rx, u32 rxlen)
+{
+	uintptr_t base = spi0_base_address();
+	u32 i, total = txlen + rxlen;
+
+	if (!total || total > 64)
+		return -EINVAL;
+	writel(total, base + SUN6I_SPI0_MBC);
+	writel(txlen, base + SUN6I_SPI0_MTC);
+	writel(txlen, base + SUN6I_SPI0_BCC);
+	for (i = 0; i < txlen; i++)
+		writeb(tx[i], base + SUN6I_SPI0_TXD);
+	setbits_le32(base + SUN6I_SPI0_TCR, SUN6I_TCR_XCH);
+	for (i = 0; i < 10000; i++) {
+		if ((readl(base + SUN6I_SPI0_FIFO_STA) & 0x7f) >= total)
+			break;
+		udelay(1);
+	}
+	if (i == 10000)
+		return -ETIMEDOUT;
+	for (i = 0; i < txlen; i++)
+		readb(base + SUN6I_SPI0_RXD);
+	for (i = 0; i < rxlen; i++)
+		rx[i] = readb(base + SUN6I_SPI0_RXD);
+	udelay(1); /* CS high time before the next command. */
+	return 0;
+}
+
+#include "gateway_spinand_spl.h"
+#endif
+
 static ulong spi_load_read(struct spl_load_info *load, ulong sector,
 			   ulong count, void *buf)
 {
+#ifdef CONFIG_SPL_SPI_SUNXI_GATEWAY_NAND
+	int ret = gn_read(buf, sector, count);
+
+	if (ret) {
+		printf("W25N01GV read error %d at 0x%lx\n", ret, sector);
+		return 0;
+	}
+#else
 	spi0_read_data(buf, sector, count);
-
+#endif
 	return count;
 }
 
@@ -383,7 +423,17 @@
 
